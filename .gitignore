# ═════════════════════════════════════════════════════════════
#  Learn8 .gitignore
#  原則：repo 只放「讓系統能建置、執行、測試」所需的檔案與說明文件。
#  其餘（機密、使用者資料、可重建的產物、簡報與歷史素材）只留在本機。
# ═════════════════════════════════════════════════════════════

# ─── 1. 機密與本機設定（任何位置）──────────────────────────────
**/.env
**/.env.*
!**/.env.example
.claude/settings.local.json

# ─── 2. 執行期產生的使用者資料 ────────────────────────────────
backend/data/uploads/
backend/data/logs/
backend/data/temp/
backend/data/chroma_db/
backend/logs/*
!backend/logs/.gitkeep
projects_pool/
uploads/
*.db
*.sqlite3

# ─── 3. 研究原始資料（受試者腦波、測驗卷與解答）────────────────
muse2/Data/
muse2/Test_PDF/

# ─── 4. 內部文件（策略、商業、計畫、合作）──────────────────────
docs/research/
docs/market/
docs/plan/
docs/b2b/

# ─── 5. 非系統內容：簡報、影片、海報、歷史版本、外部服務 ──────
#    本機保留；簡報另存於 github.com/kaigiii/Learn8_presentation
/presentation/
/archive/
services/voxcpm/
/推甄準備/

# ─── 6. 可重建的產物與快取 ─────────────────────────────────────
# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
*.egg
.eggs/
.installed.cfg
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
venv/
.venv/
env/
build/
dist/
**/dist/
develop-eggs/
downloads/
eggs/
lib/
!/frontend/src/lib/
!/frontend/src/lib/**
lib64/
parts/
sdist/
var/
wheels/
# Node / Next.js
node_modules/
.next/
.next-dev/
out/
coverage/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
# 媒體與工具快取
*.mov
*.mp4
**/.hyperframes/

# ─── 7. 系統與編輯器 ───────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
