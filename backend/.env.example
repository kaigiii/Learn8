PROJECT_NAME=Learn8
API_V1_STR=/api/v1

# CORS 允許來源（逗號分隔）
# 開發可用 *，正式環境建議指定前端網域，例如：
# CORS_ALLOW_ORIGINS=https://app.learn8.ai,https://staging.learn8.ai
CORS_ALLOW_ORIGINS=*

SECRET_KEY=changethis
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=3000
DATABASE_URL=postgresql://localhost:5432/learn8_db
REDIS_URL=redis://localhost:6379/0

# Dev login 僅供本機開發，正式環境請保持 false
AUTH_ENABLE_DEV_LOGIN=True
AUTH_DEV_LOGIN_EMAIL=dev@learn8.ai
AUTH_DEV_LOGIN_PASSWORD=dev_password

# 安全性設定 (登入嘗試限制與密碼重設)
AUTH_MAX_LOGIN_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
AUTH_MAX_RESET_REQUESTS_PER_HOUR=3
AUTH_RESET_TOKEN_TTL_MINUTES=30
AUTH_DEBUG_EXPOSE_RESET_TOKEN=False

# 背景 job 多少分鐘無更新就標記為 STALE
JOB_STALE_TIMEOUT_MINUTES=10

ARENA_ADMIN_EMAILS=dev@learn8.ai

# Lobby 房間閒置超過 N 分鐘自動關閉（0 代表停用）
ARENA_ROOM_IDLE_CLOSE_MINUTES=15

# 競技配對 queue 等待逾時分鐘數
ARENA_QUEUE_EXPIRE_MINUTES=3
# Match 在 in_progress 但長時間無活動時，強制 finalize 的秒數
ARENA_MATCH_STALE_FINALIZE_SECONDS=900

# 競技配對參數
ARENA_MATCHMAKING_BASE_WINDOW=9999            # 初始允許的分數差距（設為 0 代表等級必須完全相同才配對）
ARENA_MATCHMAKING_MAX_WINDOW=9999           # 最大允許的分數差距
ARENA_MATCHMAKING_WINDOW_STEP_SECONDS=5     # 每隔 N 秒擴張一次範圍 
ARENA_MATCHMAKING_WINDOW_EXPANSION=50       # 每次擴張增加的範圍（設為 0 代表不隨時間擴張）
ARENA_MATCHMAKING_RECENT_REMATCH_LOOKBACK=0 # 避開最近 N 場的對手
ARENA_MATCHMAKING_REMATCH_RELAX_SECONDS=120 # 若等待超過 N 秒則無視重複對手限制
ARENA_MATCHMAKING_REMATCH_PRIORITY_PENALTY=1000 # 針對近期對手的積分懲罰（設為 1000 代表嚴格避開，50 代表較寬鬆）

# --- AI Config (大腦：生成課程與對話) ---
GOOGLE_API_KEY=
# LLM 供應商選擇 (選項: google | lmstudio | mock)
LLM_PROVIDER=google
# 預設使用的 Gemini 模型
GEMINI_MODEL=gemini-2.5-flash 
# LMStudio 本地端點與模型名稱
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=mirothinker-v1.5-30b

# --- Application Limits & Pricing ---
COST_SYLLABUS_GENERATION=50
COST_LESSON_GENERATION=5
COST_QUESTIONNAIRE_GENERATION=5
MAX_FILE_READ_BYTES=50000
MAX_COURSE_CONTEXT_BYTES=100000

# --- Document Processing (視力：解析PDF與圖片) ---
# PDF 解析策略 (選項: basic | vision | hybrid)
# basic: 0成本純文字 (PyMuPDF)
# vision: 強制使用多模態視覺解析 (耗費API)
# hybrid: 智慧混搭 (無圖片用 basic, 有圖片用 vision)
PDF_PARSE_STRATEGY=hybrid

# 負責看圖的 Vision LLM 供應商 (選項: google | lmstudio)
# 推薦使用 google 以獲得最佳的圖表轉 Markdown 效果
VISION_LLM_PROVIDER=google
VISION_GEMINI_MODEL=gemini-2.5-flash

# --- VoxCPM (Audio Service) ---
# 語音微服務端點
VOXCPM_URL=http://127.0.0.1:15060/v1/audio/speech
VOXCPM_UPLOAD_URL=http://127.0.0.1:15060/v1/audio/upload

# --- RAG Settings (檢索增強生成設定) ---
# 是否啟用查詢擴充：開啟會消耗額外1次LLM API，但能提高搜尋命中率
RAG_ENABLE_QUERY_EXPANSION=false
# RAG_TOP_K: 每一個節點生成時，最終餵給 LLM 的關聯文本數量（調小可省 Token，調大內容更準）
RAG_TOP_K=4
# RAG_SEARCH_K: 每次檢索時從資料庫抓取的數量（通常設為 RAG_TOP_K 的一半或相等）
RAG_SEARCH_K=2
# 文本切片大小與重疊量：影響索引品質
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200

# --- Workflow Settings (工作流效能設定) ---
# 同時向 LLM 展開多少個單元：若用輕量級模型或 API Limit 足夠，調高能大幅加快整體課程生成速度
SYLLABUS_CONCURRENCY_LIMIT=3
MAX_SYLLABUS_AUDIT_REFLECTIONS=2
PLANNER_AGENT_MODEL=gemini-2.5-flash
AUDITOR_AGENT_MODEL=gemini-2.5-flash

# --- LLM Shared Settings (LLM 共用設定) ---
# 控制生成的隨機性 (0.0=穩定, 1.0=極具創意)
LLM_TEMPERATURE=0.7
# 地端模型最大生成 Token 數
LMSTUDIO_MAX_TOKENS=16384

# --- Content Whitelists (逗號分隔檔名) ---
# 指定要載入的公用課程 YAML 檔案
ENABLED_PUBLIC_COURSES=ai_neural_networks.yaml,python_fundamentals.yaml,world_history.yaml
# 指定要載入的遊戲模組 YAML 檔案
ENABLED_GAME_MODULES=ExplainerMedia.yaml,FeynmanMirror.yaml,MatchingPairs.yaml,MultipleChoice.yaml,Ordering.yaml

# Feynman Mirror dialogue limit
DEFAULT_FEYNMAN_MAX_ROUNDS=10
DEFAULT_VOICE_PRESET=preset_01
