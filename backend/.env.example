PROJECT_NAME=Learn8
API_V1_STR=/api/v1
SECRET_KEY=changethis
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=3000
DATABASE_URL=sqlite:///./learn8_db/learn8.db

# --- AI Config (大腦：生成課程與對話) ---
GOOGLE_API_KEY=
# LLM 供應商選擇 (選項: google | lmstudio)
LLM_PROVIDER=google
# 預設使用的 Gemini 模型
GEMINI_MODEL=gemini-2.5-flash 
# LMStudio 本地端點與模型名稱
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=mirothinker-v1.5-30b

# --- Application Limits & Pricing ---
COST_SYLLABUS_GENERATION=50
COST_LESSON_GENERATION=5
COST_QUESTIONNAIRE_GENERATION=5
MAX_FILE_READ_BYTES=50000
MAX_COURSE_CONTEXT_BYTES=30000

# --- Document Processing (視力：解析PDF與圖片) ---
# PDF 解析策略 (選項: basic | vision | hybrid)
# basic: 0成本純文字 (PyMuPDF)
# vision: 強制使用多模態視覺解析 (耗費API)
# hybrid: 智慧混搭 (無圖片用 basic, 有圖片用 vision)
PDF_PARSE_STRATEGY=hybrid

# 負責看圖的 Vision LLM 供應商 (選項: google | lmstudio)
# 推薦使用 google 以獲得最佳的圖表轉 Markdown 效果
VISION_LLM_PROVIDER=google
VISION_GEMINI_MODEL=gemini-2.5-flash

# --- RAG Settings (檢索增強生成設定) ---
# 是否啟用查詢擴充：開啟會消耗額外1次LLM API，但能提高搜尋命中率
RAG_ENABLE_QUERY_EXPANSION=false
# RAG_TOP_K: 每一個節點生成時，最終餵給 LLM 的關聯文本數量（調小可省 Token，調大內容更準）
RAG_TOP_K=4
# RAG_SEARCH_K: 每次檢索時從資料庫抓取的數量（通常設為 RAG_TOP_K 的一半或相等）
RAG_SEARCH_K=2
# 文本切片大小與重疊量：影響索引品質
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200

# --- Workflow Settings (工作流效能設定) ---
# 同時向 LLM 展開多少個單元：若用輕量級模型或 API Limit 足夠，調高能大幅加快整體課程生成速度
SYLLABUS_CONCURRENCY_LIMIT=3

# --- LLM Shared Settings (LLM 共用設定) ---
# 控制生成的隨機性 (0.0=穩定, 1.0=極具創意)
LLM_TEMPERATURE=0.7
# 地端模型最大生成 Token 數
LMSTUDIO_MAX_TOKENS=16384
