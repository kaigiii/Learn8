iento."}],"correctOptionId":"opt3"}}},{"stageId":"feynmanCompareNeurons","topic":"Comparación de Neuronas","skin":"Scientific","component":"FeynmanMirror","difficulty":"high","recommendedDurationMinutes":4,"validation":{"type":"logic","condition":{}},"feedback":{"success":"¡Fantástico! Has articulado claramente las similitudes y diferencias. Esto demuestra una gran comprensión.","error":"Tu explicación es un buen comienzo, pero intenta ser más específico sobre los paralelos y las distinciones clave entre las neuronas biológicas y artificiales."},"config":{"initialState":{},"data":{"prompt":"Explica las principales similitudes y diferencias entre una neurona biológica y una neurona artificial (el perceptrón), utilizando tus propias palabras."}}}]}
