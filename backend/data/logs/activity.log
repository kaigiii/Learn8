    [".", ".", ".", "R", ".", ".", "K", "."]
  ],
  "initial_fen": "5r1k/ppp2ppp/8/8/8/8/PPP2PPP/3R2K1 w - - 0 1",
  "player_color": "w",
  "solution_sequence": [
    {
      "move": "d1d8",
      "opponent_response": "f8d8",
      "explanation": "White forces the rook away from the back rank."
    },
    {
      "move": "d8d8",
      "opponent_response": null,
      "explanation": "Checkmate. The king is trapped by its own pawns."
    }
  ],
  "hint": "Attack the back rank where the king's mobility is limited."
}
```

Example 2: Knight Fork (White to move)
```json
{
  "scenario": "Tactical coordination is like a system of linear equations where one variable affects many. Find the move that attacks two high-value targets.",
  "board_layout": [
    ["r", ".", ".", ".", ".", ".", ".", "."],
    [".", ".", ".", "q", ".", ".", ".", "."],
    [".", ".", ".", ".", ".", ".", ".", "."],
